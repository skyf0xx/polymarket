# ── Wallet / CLOB ────────────────────────────────────────────────────
# Your Polygon wallet private key
PRIVATE_KEY=your_private_key_here

# Your proxy/funder wallet address (from polymarket.com/settings)
FUNDER_ADDRESS=0xyour_funder_address_here

# Signature type: 0=EOA, 1=POLY_PROXY, 2=GNOSIS_SAFE
SIGNATURE_TYPE=2

# ── Odds API ─────────────────────────────────────────────────────────
ODDS_API_KEY=your_odds_api_key_here

ODDS_API_REST_URL=https://api.odds-api.io
ODDS_API_WS_URL=wss://api.odds-api.io/v3/ws

# Bookmaker key for implied probabilities (exact key as returned by odds-api.io, e.g. pinnacle, draftkings, fanduel)
BOOKMAKER_ID=

# ── Anthropic (market matching) ──────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Comma-separated odds-api.io sport keys (GET /v3/sports for full list)
# e.g. basketball, football, american-football, ice-hockey, tennis
ODDS_API_SPORTS=basketball,football

# Comma-separated Polymarket sports market types (GET /sports/market-types for full list)
# Only these market types are fetched from Gamma for LLM matching
POLYMARKET_SPORTS_TYPES=moneyline,spreads,totals

# Comma-separated Polymarket tag IDs to filter by league (fetches per-tag, deduped)
# https://docs.polymarket.com/api-reference/sports/get-sports-metadata-information?playground=open#get-sports-metadata-information
# Leave empty to fetch all sports. Common IDs:
#   745=NBA, 450=NFL, 82=EPL, 780=La Liga, 1494=Bundesliga
#   101962=Serie A, 102070=Ligue 1, 100977=UCL, 899=NHL
POLYMARKET_TAG_IDS=

# Minimum liquidity to include a Polymarket market (filters out dead markets)
POLYMARKET_MIN_LIQUIDITY=1000

# Comma-separated Gamma Teams API league codes for team abbreviation hydration
# These are Polymarket/Gamma league slugs (NOT Odds API slugs like "usa-nba")
# Used by team-knowledge to resolve abbreviations for deterministic matching
GAMMA_LEAGUES=nba,cbb,wnba,nfl,cfb,mlb,atp,wta,epl

# Maps Gamma/Polymarket league slug (slug prefix, e.g. "epl") → Odds API sport name.
# Used by the market-matcher pre-filter to only send relevant odds events to the LLM.
# Defaults are built in — only set this to override or add new leagues.
# Format: league:sport pairs, comma-separated
# e.g. epl:football,nba:basketball,nfl:american-football,mlb:baseball,atp:tennis
GAMMA_LEAGUE_TO_ODDS_API_SPORT=epl:football,nba:basketball,nfl:american-football,mlb:baseball,cbb:basketball,wnba:basketball,cfb:american-football,atp:tennis,wta:tennis

# Comma-separated Odds API league codes to filter the WS feed (max 20)
# Leave empty to receive all leagues for the selected sports
# e.g. usa-nba, usa-nfl, england-premier-league
ODDS_API_LEAGUES=


# ── Strategy ─────────────────────────────────────────────────────────
# Market maker mode: post limit orders inside the spread (maker = zero fees).
# When false, crosses the spread as a taker (pays ~3% fee on sports markets).
MARKET_MAKER=false

# ── Edge & Sizing ────────────────────────────────────────────────────
# Minimum net edge required to place a trade (2% default)
MIN_EDGE=0.02
# Minimum token price to consider (filters dead/noise markets)
MIN_PRICE=0.10

# Kelly fraction multiplier — 0.25 = quarter Kelly
KELLY_FRACTION=0.25

# Hard cap: adjusted Kelly cannot exceed this fraction of bankroll (2% default)
MAX_KELLY_PCT=0.02

# Max % of bankroll to deploy in a single market (10% default)
MAX_POSITION_PCT=0.10

# Max % of bankroll across all markets for the same event/match (15% default)
MAX_EVENT_PCT=0.15

# ── Timing ───────────────────────────────────────────────────────────
# Per-token cooldown after a signal fires (seconds)
COOLDOWN_SECONDS=30

# Debounce window to batch rapid price updates (ms)
DEBOUNCE_MS=500

# How often to run maintenance (refresh markets, re-match, update bankroll) in ms
MAINTENANCE_INTERVAL_MS=300000

# ── Operation ────────────────────────────────────────────────────────
# true = log signals only, no real orders placed
DRY_RUN=true

# true = print info/debug logs to console (errors and warnings always print)
VERBOSE=false

# Directory for persisted data (match-table.json, trades.jsonl)
DATA_DIR=./data

# Path to CLOB API credentials file (created automatically on first run)
CREDS_FILE=./api_creds.json


MATCHER_MODEL=claude-haiku-4-5-20251001

# ── Polygon RPC ──────────────────────────────────────────────────────
POLYGON_RPC=https://polygon-rpc.com
