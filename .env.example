# Your Polygon wallet private key (0x-prefixed)
PRIVATE_KEY=0x...

# Your proxy/funder wallet address (from polymarket.com/settings)
FUNDER_ADDRESS=0x...

# Signature type: 0=EOA (Externally Owned Account), 1=POLY_PROXY, 2=GNOSIS_SAFE
SIGNATURE_TYPE=2

# The wallet address of the trader to copy
TARGET_WALLET=0x6ac5bb06a9eb05641fd5e82640268b92f3ab4b6e

# Sizing mode:
#   "fixed"      = fixed USD per trade
#   "multiplier" = multiply target's usdcSize (e.g. 0.5 = 50% of their size)
#   "percent"    = mirror the % of portfolio the target risked (copies their risk profile)
SIZING_MODE=percent

# If fixed: USD amount per trade. If multiplier: scale factor. If percent: ignored.
SIZING_VALUE=10

# Your total bankroll in USD (only used in "percent" mode).
# Set this to your Polymarket portfolio value so the bot can compute matching % sizes.
# If omitted, the bot will fetch it from the API using your FUNDER_ADDRESS.
# MY_BANKROLL=1000

# Poll interval in ms (default 5 min = 300000)
POLL_INTERVAL_MS=300000

# Max price slippage tolerance (e.g. 5 = 5%). Skip trade if current price drifted too far.
MAX_SLIPPAGE=5    
