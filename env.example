# ── Wallet / CLOB ──────────────────────────────────────────────
PRIVATE_KEY=0xYOUR_POLYGON_PRIVATE_KEY_HERE
FUNDER_ADDRESS=0xYOUR_PROXY_WALLET_ADDRESS_HERE
SIGNATURE_TYPE=2

# ── The Odds API ───────────────────────────────────────────────
ODDS_API_KEY=your_odds_api_key_here
ODDS_API_WS_URL=wss://api.odds-api.io/v3/ws
# Bookmaker key for implied probabilities (exact key as returned by odds-api.io, e.g. pinnacle, draftkings, fanduel)
BOOKMAKER_ID=

# ── Sports (comma-separated sport keys) ───────────────────────
SPORTS=basketball_nba,soccer_epl

# ── Edge & Sizing ─────────────────────────────────────────────
MIN_EDGE=0.02
KELLY_FRACTION=0.25
MAX_POSITION_PCT=0.10

# ── Timing ────────────────────────────────────────────────────
COOLDOWN_SECONDS=30
DEBOUNCE_MS=500
MAINTENANCE_INTERVAL_MS=300000
STALE_CACHE_THRESHOLD_MS=60000

# ── Operation ─────────────────────────────────────────────────
DRY_RUN=true
DATA_DIR=./data
CREDS_FILE=./api_creds.json

# ── Anthropic (for LLM market matching) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here
MATCHER_MODEL=claude-haiku-4-5-20251001

# ── Polygon RPC ───────────────────────────────────────────────
POLYGON_RPC=https://polygon-rpc.com
